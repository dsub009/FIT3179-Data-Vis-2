{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Each food type has its own nutrient fingerprint",
    "subtitle": "Median per 100 g. Darker = more of that nutrient, compared across food types.",
    "anchor": "start"
  },
  "width": 520,
  "height": 380,
  "data": {
    "url": "data/openhsr_clean.csv"
  },
  "transform": [
    {
      "fold": [
        "sugars_g_per_100g",
        "sat_fat_g_per_100g",
        "sodium_mg_per_100g",
        "fiber_g_per_100g",
        "protein_g_per_100g"
      ],
      "as": [
        "key",
        "value"
      ]
    },
    {
      "calculate": "{\"sugars_g_per_100g\": \"Sugars (g)\", \"sat_fat_g_per_100g\": \"Saturated fat (g)\", \"sodium_mg_per_100g\": \"Salt: sodium (mg)\", \"fiber_g_per_100g\": \"Fibre (g)\", \"protein_g_per_100g\": \"Protein (g)\"}[datum.key]",
      "as": "nutrient"
    },
    {
      "aggregate": [
        {
          "op": "median",
          "field": "value",
          "as": "med"
        }
      ],
      "groupby": [
        "product_group",
        "nutrient"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "med",
          "as": "mx"
        }
      ],
      "groupby": [
        "nutrient"
      ]
    },
    {
      "calculate": "datum.med / datum.mx",
      "as": "rel"
    }
  ],
  "encoding": {
    "y": {
      "field": "product_group",
      "type": "nominal",
      "title": null,
      "sort": [
        "Snacks & sweets",
        "Other",
        "Bakery",
        "Breakfast cereals",
        "Drinks",
        "Dairy & eggs",
        "Sauces & other processed",
        "Vegetables & canned",
        "Frozen foods",
        "Meat",
        "Pasta, rice & grains"
      ],
      "axis": {
        "labelLimit": 220,
        "domain": false,
        "ticks": false
      }
    },
    "x": {
      "field": "nutrient",
      "type": "nominal",
      "title": null,
      "sort": [
        "Sugars (g)",
        "Saturated fat (g)",
        "Salt: sodium (mg)",
        "Fibre (g)",
        "Protein (g)"
      ],
      "axis": {
        "orient": "top",
        "labelAngle": 0,
        "labelLimit": 90,
        "domain": false,
        "ticks": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "color": {
          "field": "rel",
          "type": "quantitative",
          "scale": {
            "scheme": "oranges",
            "domain": [
              0,
              1
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "product_group",
            "title": "Food type"
          },
          {
            "field": "nutrient",
            "title": "Nutrient"
          },
          {
            "field": "med",
            "title": "Median per 100 g",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12
      },
      "encoding": {
        "text": {
          "field": "lab",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.rel > 0.55",
            "value": "white"
          },
          "value": "#333"
        }
      },
      "transform": [
        {
          "calculate": "indexof(datum.nutrient,'sodium') >= 0 ? format(datum.med,'.0f') : format(datum.med,'.1f')",
          "as": "lab"
        }
      ]
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}