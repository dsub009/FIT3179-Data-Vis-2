     "as": "ym"
    },
    {
     "filter": "datum.side === 'left'"
    }
   ],
   "mark": {
    "type": "text",
    "fontSize": 12,
    "fontWeight": "normal",
    "color": "#666",
    "align": "right",
    "dx": -10,
    "dy": 10
   },
   "encoding": {
    "x": {
     "field": "x0",
     "type": "quantitative",
     "scale": {
      "domain": [
       -0.6,
       2.75
      ]
     },
     "axis": null
    },
    "y": {
     "field": "ym",
     "type": "quantitative",
     "scale": {
      "domain": [
       0,
       1
      ],
      "reverse": true
     },
     "axis": null
    },
    "text": {
     "field": "sub"
    }
   }
  },
  {
