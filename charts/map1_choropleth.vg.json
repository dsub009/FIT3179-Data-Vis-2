{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where are adults most likely to be overweight or obese?",
    "subtitle": "Share of adults by state and territory, 2022"
  },
  "width": 600,
  "height": 450,
  "projection": {
    "type": "conicEqualArea",
    "rotate": [-134, 0, 0],
    "parallels": [-18, -36]
  },
  "data": {
    "url": "data/australia_states.topojson",
    "format": { "type": "topojson", "feature": "STE_2021_AUST_GDA2020" }
  },
  "transform": [
    {
      "lookup": "properties.STE_NAME21",
      "from": {
        "data": { "url": "data/health_by_state.csv" },
        "key": "state",
        "fields": ["overweight_obese_pct"]
      }
    }
  ],
  "mark": { "type": "geoshape", "stroke": "white", "strokeWidth": 1.5 },
  "encoding": {
    "color": {
      "field": "overweight_obese_pct",
      "type": "quantitative",
      "scale": {
        "type": "threshold",
        "domain": [64, 66, 68, 70],
        "range": ["#f2f0f7", "#cbc9e2", "#9e9ac8", "#756bb1", "#54278f"]
      },
      "legend": { "title": "Overweight or obese (%)" }
    },
    "tooltip": [
      { "field": "properties.STE_NAME21", "type": "nominal", "title": "State" },
      { "field": "overweight_obese_pct", "type": "quantitative", "title": "Overweight or obese (%)" }
    ]
  }
}