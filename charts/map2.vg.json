{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Most adults miss fruit and vegetable guidelines",
    "subtitle": "Share of adults who did not meet each guideline. Pick a measure. Colours rescale to each measure.",
    "anchor": "start"
  },
  "width": 360,
  "height": 360,
  "data": {
    "url": "data/state_tiles.csv"
  },
  "params": [
    {
      "name": "measure",
      "value": "fruit_not_met_pct",
      "bind": {
        "input": "select",
        "name": "Measure: ",
        "options": [
          "fruit_not_met_pct",
          "veg_not_met_pct",
          "fruit_veg_neither_met_pct"
        ],
        "labels": [
          "Did not meet fruit guideline",
          "Did not meet vegetable guideline",
          "Met neither guideline"
        ]
      }
    }
  ],
  "transform": [
    {
      "lookup": "state",
      "from": {
        "data": {
          "url": "data/health_by_state.csv"
        },
        "key": "state",
        "fields": [
          "fruit_not_met_pct",
          "veg_not_met_pct",
          "fruit_veg_neither_met_pct"
        ]
      }
    },
    {
      "calculate": "datum[measure]",
      "as": "value"
    },
    {
      "joinaggregate": [
        {
          "op": "min",
          "field": "value",
          "as": "vmin"
        },
        {
          "op": "max",
          "field": "value",
          "as": "vmax"
        }
      ]
    },
    {
      "calculate": "(datum.value - datum.vmin) / (datum.vmax - datum.vmin)",
      "as": "rank01"
    }
  ],
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null,
      "scale": {
        "paddingInner": 0.06,
        "paddingOuter": 0
      }
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null,
      "scale": {
        "paddingInner": 0.06,
        "paddingOuter": 0
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 6
      },
      "encoding": {
        "color": {
          "field": "value",
          "type": "quantitative",
          "scale": {
            "scheme": "oranges",
            "zero": false
          },
          "legend": {
            "title": "Share of adults (%)",
            "orient": "bottom",
            "gradientLength": 260
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Share of adults (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.rank01 > 0.55"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 16,
        "dy": -8,
        "fontWeight": "bold",
        "color": "white"
      },
      "encoding": {
        "text": {
          "field": "abbr",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.rank01 <= 0.55"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 16,
        "dy": -8,
        "fontWeight": "bold",
        "color": "#333"
      },
      "encoding": {
        "text": {
          "field": "abbr",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.rank01 == 1"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 13,
        "dy": 12,
        "color": "white"
      },
      "encoding": {
        "text": {
          "field": "value",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.rank01 == 0"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 13,
        "dy": 12,
        "color": "#333"
      },
      "encoding": {
        "text": {
          "field": "value",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}