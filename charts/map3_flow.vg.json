{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Food flows to Australia from 16 main sources",
    "subtitle": "Line width = A$ million of food imports, 2025. Press Play to add sources from largest to smallest.",
    "anchor": "start"
  },
  "width": 720,
  "height": 380,
  "projection": {
    "type": "equalEarth",
    "rotate": [
      -150,
      0,
      0
    ]
  },
  "params": [
    {
      "name": "top",
      "value": 16,
      "bind": {
        "input": "range",
        "min": 1,
        "max": 16,
        "step": 1,
        "name": "Sources shown: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e9e5dc",
        "stroke": "white"
      }
    },
    {
      "data": {
        "url": "data/import_flows.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.rank <= top"
        }
      ],
      "mark": {
        "type": "geoshape",
        "filled": false,
        "strokeCap": "round",
        "opacity": 0.65
      },
      "encoding": {
        "stroke": {
          "value": "#2171b5"
        },
        "strokeWidth": {
          "field": "properties.imports",
          "type": "quantitative",
          "scale": {
            "range": [
              1.2,
              16
            ]
          },
          "legend": {
            "title": "Imports (A$ million)",
            "orient": "bottom",
            "symbolType": "stroke"
          }
        },
        "tooltip": [
          {
            "field": "properties.country",
            "title": "Country"
          },
          {
            "field": "properties.imports",
            "title": "Imports (A$ million)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/food_imports.csv"
      },
      "transform": [
        {
          "filter": "datum.rank <= top && (datum.rank <= 4 || datum.country === 'Malaysia')"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "dy": -10,
        "color": "#1f3d63"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "country"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 134,
            "lat": -25,
            "t": "Australia"
          }
        ]
      },
      "mark": {
        "type": "circle",
        "size": 90,
        "color": "#1f2a2e"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}