{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where does Australia's imported food come from?",
    "subtitle": "Food imports by country of origin, 2025 (A$ million). Hover over a circle for details.",
    "anchor": "start"
  },
  "width": 760,
  "height": 400,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "data/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e3e0da",
        "stroke": "white"
      }
    },
    {
      "data": {
        "url": "data/food_imports.csv"
      },
      "mark": {
        "type": "circle",
        "color": "#2171b5"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "imports_aud_m",
          "type": "quantitative",
          "title": "Imports (A$ million)",
          "scale": {
            "range": [
              60,
              3000
            ]
          }
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "imports_aud_m",
            "type": "quantitative",
            "title": "Food imports (A$ million)",
            "format": ",.0f"
          }
        ],
        "opacity": {
          "condition": {
            "param": "hover",
            "value": 1,
            "empty": false
          },
          "value": 0.65
        },
        "stroke": {
          "condition": {
            "param": "hover",
            "value": "#222",
            "empty": false
          },
          "value": "white"
        },
        "strokeWidth": {
          "condition": {
            "param": "hover",
            "value": 2.5,
            "empty": false
          },
          "value": 1
        }
      },
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "on": "mouseover",
            "clear": "mouseout",
            "fields": [
              "country"
            ]
          }
        }
      ]
    },
    {
      "data": {
        "url": "data/food_imports.csv"
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "dy": -16,
        "color": "#333"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "country",
          "type": "nominal"
        }
      },
      "transform": [
        {
          "filter": "datum.imports_aud_m >= 1400"
        }
      ]
    }
  ]
}